{
  "name": "antigravity-context-monitor-lite",
  "displayName": "Antigravity Context Monitor Lite",
  "description": "Personal-use lightweight context monitor for Antigravity IDE (Phase 1: Language Server Discovery)",
  "version": "0.1.0",
  "publisher": "personal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity-context-monitor-lite.refresh",
        "title": "Antigravity Lite: Refresh Language Server Discovery & RPC"
      },
      {
        "command": "antigravity-context-monitor-lite.testRpc",
        "title": "Antigravity Lite: Test RPC (GetAllCascadeTrajectories)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/test/*.test.js",
    "deploy": "npm run compile && node scripts/deploy.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
